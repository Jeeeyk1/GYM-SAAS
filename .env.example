# ─── API ───────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# ─── Database ──────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gymsaas
DB_USER=gymsaas
DB_PASSWORD=gymsaas_secret
DB_SSL=false
DATABASE_URL=postgresql://gymsaas:gymsaas_secret@localhost:5432/gymsaas

# ─── Redis ─────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── JWT ───────────────────────────────────────────────
JWT_SECRET=super_secret_dev_key_change_in_production_min32chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super_refresh_secret_change_in_production_32chars
JWT_REFRESH_EXPIRES_IN=7d

# ─── Throttle ──────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ─── Web (Next.js) ─────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# ─── Mobile (Expo) ─────────────────────────────────────
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
